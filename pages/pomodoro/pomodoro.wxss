/**
 * 番茄钟页样式
 */
.pomodoro-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60rpx 40rpx;
    min-height: 100vh;
    background: #f9f9f9;
}

/* 模式标签 */
.mode-tag {
    font-size: 28rpx;
    padding: 10rpx 40rpx;
    border-radius: 30rpx;
    margin-bottom: 60rpx;
    font-weight: bold;
}

.mode-tag.work {
    background-color: #fde8e8;
    color: #e74c3c;
}

.mode-tag.break {
    background-color: #e8f8e8;
    color: #27ae60;
}

/* 计时器圆环区域 */
.timer-ring {
    width: 500rpx;
    height: 500rpx;
    position: relative;
    margin-bottom: 80rpx;
}

/* 灰色底色环 */
.ring-bg {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #eee;
    position: absolute;
    top: 0;
    left: 0;
}

/* 彩色进度环 */
.ring-progress {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    position: absolute;
    top: 0;
    left: 0;
    /* conic-gradient：锥形渐变，根据 --progress 画扇形进度 */
    background: conic-gradient(
        #e74c3c 0deg,
        #e74c3c calc(var(--progress) * 360deg),
        transparent calc(var(--progress) * 360deg)
    );
}

.ring-progress.break {
    background: conic-gradient(
        #27ae60 0deg,
        #27ae60 calc(var(--progress) * 360deg),
        transparent calc(var(--progress) * 360deg)
    );
}

/* 中心白色圆（遮住锥形渐变中间，形成环形效果） */
.timer-center {
    width: 420rpx;
    height: 420rpx;
    border-radius: 50%;
    background: white;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.timer-text {
    font-size: 80rpx;
    font-weight: bold;
    color: #333;
    font-family: 'Courier New', monospace;
    /* 等宽字体，数字对齐 */
}

.timer-mode-label {
    font-size: 26rpx;
    color: #999;
    margin-top: 10rpx;
}

/* 控制按钮 */
.control-buttons {
    display: flex;
    gap: 30rpx;
    flex-wrap: wrap;
    justify-content: center;
}

.ctrl-btn {
    width: 220rpx;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 44rpx;
    font-size: 32rpx;
    font-weight: bold;
    text-align: center;
    padding: 0;
    border: none;
}

.start-btn {
    background-color: #e74c3c;
    color: white;
}

.pause-btn {
    background-color: #f39c12;
    color: white;
}

.reset-btn {
    background-color: #eee;
    color: #666;
}

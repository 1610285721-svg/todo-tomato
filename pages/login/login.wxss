/**
 * 登录页样式 —— 相当于 Vue 的 <style scoped>
 * 这里写的 CSS 只影响当前页面，不会污染其他页面
 */
.login-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    padding: 40rpx;
}

/* logo 区域 */
.logo-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 120rpx;
}

.logo-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
}

.app-name {
    font-size: 52rpx;
    color: white;
    font-weight: bold;
    margin-bottom: 15rpx;
}

.app-desc {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.8);
}

/* 登录按钮区域 */
.login-btn-area {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.wechat-login-btn {
    width: 80%;
    height: 100rpx;
    background-color: white;
    color: #e74c3c;
    border-radius: 50rpx;
    font-size: 34rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
}

.wechat-login-btn:active {
    background-color: #f0f0f0;
}

.login-tip {
    color: rgba(255, 255, 255, 0.6);
    font-size: 24rpx;
    margin-top: 25rpx;
}
